[Desktop Entry]
Version=1.0
Type=Application
Name=SubSweep Recon Studio
GenericName=OSINT Reconnaissance & Lead Intelligence Workstation
Comment=Zero-Dependency OSINT Reconnaissance, Subdomain Enumerator, Port Prober & Business Lead Harvester
Exec=/usr/local/bin/subsweep desktop
Icon=/media/neo/f2fdda77-178b-4603-ae80-c7aa4cd97908/zoth-micro-repos/subsweep-lead-scanner/assets/icon.png
Terminal=false
Categories=Security;Network;Development;System;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open SubSweep CLI
Exec=x-terminal-emulator -e "/usr/local/bin/subsweep --help"

[Desktop Action Web]
Name=Open Web UI (Port 8090)
Exec=/usr/local/bin/subsweep web
