[Desktop Entry]
Version=1.0
Type=Application
Name=SubSweep Recon Studio
GenericName=OSINT Subdomain Recon & Lead Harvester
Comment=Zero-Dependency OSINT Reconnaissance, Subdomain Enumerator, Port Prober & Business Lead Harvester
Exec=/usr/local/bin/subsweep desktop
Icon=subsweep
Terminal=false
Categories=Security;Network;Development;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open SubSweep CLI
Exec=x-terminal-emulator -e "/usr/local/bin/subsweep --help"

[Desktop Action Web]
Name=Open Web UI (Port 8090)
Exec=/usr/local/bin/subsweep web
